---
import Base from '../../layouts/Base.astro';
import EnquiryForm from '../EnquiryForm.astro';
import pages from '../../data/pages.json';
import { DEFAULT_LOCALE } from '../../i18n/config.mjs';
import { pageTexts, pageTitle } from '../../i18n/dict.mjs';
import { localizeHtml, localizeLinks } from '../../i18n/html.mjs';
import { faqSchema } from '../../i18n/schema.mjs';
import enPages from '../../i18n/pages/en.json';

const { locale = DEFAULT_LOCALE, slug } = Astro.props;
const page = pages.find((p) => p.slug === slug);
if (!page) throw new Error(`Unknown static page slug: ${slug}`);

const translated = pageTexts(locale, slug);
const { html, used, expected } = localizeHtml(page.html, translated);
const body = localizeLinks(html, locale);
if (locale !== 'en' && used < expected - 12) {
  console.warn(`[i18n] ${locale}/${slug}: only ${used}/${expected} text nodes translated`);
}

const hasH1 = /<h1[\s>]/i.test(body);
const parts = body.split('<!-- ASTRO_FORM_SLOT -->');
const heading = pageTitle(locale, slug) || page.title;

// The FAQ page already contains 12 real Q&A pairs with concrete figures
// (MOQ, lead times, payment terms). Exposing them as FAQPage makes those
// facts machine-readable for ChatGPT / Gemini without writing new copy.
const faqNode = page.slug === 'faqs'
  ? faqSchema(locale, enPages.pages.faqs.texts, translated)
  : null;
---
<Base seoKey={page.slug} path={`/${page.slug}/`} locale={locale} structuredData={faqNode ? [faqNode] : []}>
  <article class="wrap prose">
    {!hasH1 && <h1 set:html={heading} />}
    <div set:html={parts[0]} />
    {parts.length > 1 && (
      <>
        <EnquiryForm locale={locale} />
        <div set:html={parts[1]} />
      </>
    )}
  </article>
</Base>
