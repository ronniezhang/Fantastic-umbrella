---
import Base from '../../layouts/Base.astro';
import products from '../../data/products.json';
import { DEFAULT_LOCALE, localePath } from '../../i18n/config.mjs';
import { ui, fill, productCopy } from '../../i18n/dict.mjs';

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = ui(locale);
const h = t.home;
const L = (p) => localePath(locale, p);
const primary = products.filter((p) => p.scope === 'primary');
const featured = (primary.length ? primary : products).slice(0, 6);
const nameOf = (p) => productCopy(locale, p.slug)?.name || p.name;
---
<Base seoKey="home" path="/" locale={locale}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1>{h.h1}</h1>
      <p>{h.intro}</p>
      <div class="hero-actions">
        <a class="btn" href={L('/contact/#enquiry-form')}>{t.nav.quote}</a>
        <a class="btn btn-ghost" href={L('/services/')}>{t.common.exploreCapabilities}</a>
      </div>
      <p class="hero-note">{h.note}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{h.supplyTitle}</h2>
      <p>{h.supplyBody}</p>
      <div class="grid-3">
        {h.capabilities.map((c, i) => (
          <div class="card">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--wash);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="wrap">
      <h2>{h.programmesTitle}</h2>
      <p>{h.programmesBody}</p>
      <div class="grid-3">
        {h.programmes.map((c) => (
          <div class="card"><h3>{c.title}</h3><p>{c.text}</p></div>
        ))}
      </div>
      <p style="margin-top:26px"><a class="btn btn-ghost" href={L('/faqs/')}>{t.common.readFaq}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{h.rangeTitle}</h2>
      <p>{h.rangeBody}</p>
      <div class="product-grid">
        {featured.map((p) => (
          <a class="product-card" href={L(`/product/${p.slug}/`)}>
            <div class="thumb">
              {p.image
                ? <img src={p.image} alt={nameOf(p)} loading="lazy" />
                : <span style="color:#8b9aa8;font-size:13px">{t.common.imagePending}</span>}
            </div>
            <div class="body">
              <h3 set:html={nameOf(p)} />
              <p>{t.common.customOnRequest}</p>
              <span class="link">{t.common.viewEnquire}</span>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top:26px"><a class="btn btn-ghost" href={L('/products/')}>{fill(t.common.seeAllProducts, { count: products.length })}</a></p>
      <p style="margin-top:18px;font-size:14px;color:var(--ink-soft)">{t.common.greenmarkHome}</p>
    </div>
  </section>

  <section class="section" style="background:var(--navy);color:#fff">
    <div class="wrap">
      <h2 style="color:#fff">{h.ctaTitle}</h2>
      <p style="color:#c8d7e4">{h.ctaBody}</p>
      <a class="btn" href={L('/contact/#enquiry-form')}>{t.nav.quote}</a>
    </div>
  </section>
</Base>
