---
/**
 * Astro-native replacement for the Fluent Forms shortcode.
 * Field names match the live WordPress form exactly, so notification
 * templates and any downstream CRM mapping stay unchanged:
 * full_name / company / email / country / product_interest /
 * estimated_quantity / message / target_market / annual_volume /
 * preferred_incoterm
 *
 * The form POSTs to a same-origin Pages Function at /api/enquiry.
 * The endpoint (functions/api/enquiry.ts) is configured purely through
 * Pages environment variables - no secret is ever shipped to the browser.
 */
const products = [
  'Compact / folding umbrella',
  'Three-fold umbrella',
  'Five-fold / ultra-compact umbrella',
  'Straight / stick umbrella',
  'Golf umbrella',
  'Kids umbrella',
  'Promotional / printed umbrella',
  'Beach umbrella / parasol',
  'Not sure yet',
];
const endpoint = import.meta.env.PUBLIC_ENQUIRY_ENDPOINT || '/api/enquiry';
const fallbackEmail = 'sales@fantasticumbrella.com';
---
<section class="form-shell" id="enquiry-form">
  <h2>Send us your enquiry</h2>
  <p style="margin:0;color:var(--ink-soft);font-size:14px">
    New projects, repeat orders, sampling requests and specification questions.
    Fields marked <span class="req">*</span> are required.
  </p>
  <form id="b2b-enquiry" data-endpoint={endpoint} data-fallback={fallbackEmail}>
    <div class="form-grid">
      <div class="field">
        <label for="full_name">Full name <span class="req">*</span></label>
        <input id="full_name" name="full_name" type="text" required maxlength="500" placeholder="Your name" />
      </div>
      <div class="field">
        <label for="company">Company <span class="req">*</span></label>
        <input id="company" name="company" type="text" required maxlength="500" placeholder="Company name" />
      </div>
      <div class="field">
        <label for="email">Business email <span class="req">*</span></label>
        <input id="email" name="email" type="email" required maxlength="200" placeholder="name@company.com" />
      </div>
      <div class="field">
        <label for="country">Country / region <span class="req">*</span></label>
        <input id="country" name="country" type="text" required maxlength="500" placeholder="Where you are based" />
      </div>
      <div class="field">
        <label for="product_interest">Product interest <span class="req">*</span></label>
        <select id="product_interest" name="product_interest" required>
          <option value="">Select a product type</option>
          {products.map((p) => <option value={p}>{p}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="estimated_quantity">Estimated quantity <span class="req">*</span></label>
        <input id="estimated_quantity" name="estimated_quantity" type="text" required maxlength="500" placeholder="e.g. 500 pcs" />
        <span class="hint">An estimate is enough at this stage.</span>
      </div>
      <div class="field">
        <label for="target_market">Target market</label>
        <input id="target_market" name="target_market" type="text" maxlength="500" placeholder="e.g. EU, US, resort groups" />
      </div>
      <div class="field">
        <label for="annual_volume">Annual purchase volume</label>
        <input id="annual_volume" name="annual_volume" type="text" maxlength="500" placeholder="Optional" />
      </div>
      <div class="field">
        <label for="preferred_incoterm">Preferred trade term</label>
        <select id="preferred_incoterm" name="preferred_incoterm">
          <option value="">Not sure yet</option>
          <option>EXW</option><option>FOB</option><option>CIF</option><option>DDP</option>
        </select>
      </div>
      <div class="field field-full">
        <label for="message">Your requirements <span class="req">*</span></label>
        <textarea id="message" name="message" required maxlength="5000" placeholder="Size, frame, fabric, artwork, print placement, target price, delivery window..."></textarea>
        <span class="hint">Your artwork and specification stay confidential and are used only for your quotation.</span>
      </div>
    </div>

    <input type="hidden" name="_page" id="_page" value="" />
    <input type="hidden" name="_form_time" id="_form_time" value="" />
    <div class="hp" aria-hidden="true">
      <label for="_gotcha">Leave this field empty</label>
      <input id="_gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p style="margin-top:20px">
      <button class="btn" type="submit">Request a Quote</button>
    </p>
    <div id="form-status" class="form-status" hidden role="status" aria-live="polite"></div>
    <p class="form-note">
      We use these details only to prepare your quotation. We normally reply within one business day.
      You can also email <a href={`mailto:${fallbackEmail}`}>{fallbackEmail}</a> directly.
    </p>
  </form>
</section>

<script>
  const form = document.getElementById('b2b-enquiry');
  const status = document.getElementById('form-status');
  const pageInput = document.getElementById('_page');
  const timeInput = document.getElementById('_form_time');

  if (pageInput) pageInput.value = window.location.href;
  const markOpened = () => { if (timeInput) timeInput.value = String(Date.now()); };
  markOpened();

  const show = (kind, message, fallback) => {
    if (!status) return;
    status.hidden = false;
    status.className = `form-status ${kind}`;
    status.textContent = message;
    // Never lose a lead: on any failure give a one-click way to reach sales.
    if (fallback) {
      status.append(' ');
      const link = document.createElement('a');
      link.href = `mailto:${fallback}?subject=${encodeURIComponent('B2B umbrella enquiry')}`;
      link.textContent = `Email ${fallback}`;
      status.append(link);
    }
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    const endpoint = form.dataset.endpoint || '/api/enquiry';
    const fallback = form.dataset.fallback || 'sales@fantasticumbrella.com';

    const payload = Object.fromEntries(new FormData(form).entries());
    payload._page = window.location.href;

    show('pending', 'Sending your enquiry...');
    if (button) { button.disabled = true; button.textContent = 'Sending...'; }

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.ok) {
        throw new Error(result.message || 'We could not send your enquiry. Please try again.');
      }
      show('ok', result.message || 'Thank you. Your enquiry has been received.');
      form.reset();
      if (pageInput) pageInput.value = window.location.href;
      markOpened();
    } catch (error) {
      const message = error instanceof Error ? error.message : 'We could not send your enquiry.';
      show('err', `${message} If it keeps failing, please contact us directly:`, fallback);
    } finally {
      if (button) { button.disabled = false; button.textContent = 'Request a Quote'; }
    }
  });
</script>
