---
/**
 * Astro-native replacement for the Fluent Forms shortcode.
 * Field names match the live WordPress form exactly, so notification
 * templates and any downstream CRM mapping stay unchanged.
 *
 * The form POSTs to a same-origin Pages Function at /api/enquiry (absolute
 * path on purpose - it must NOT be prefixed with a locale).
 * All visible copy comes from the locale dictionary; option VALUES stay
 * English so the notification email and any CRM mapping remain stable.
 */
import { DEFAULT_LOCALE } from '../i18n/config.mjs';
import { ui } from '../i18n/dict.mjs';

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = ui(locale);
const englishOptions = ui('en').form.productOptions;
const labels = t.form.productOptions;

const endpoint = import.meta.env.PUBLIC_ENQUIRY_ENDPOINT || '/api/enquiry';
const fallbackEmail = 'sales@fantasticumbrella.com';

// Passed to the client script through a data attribute. Using define:vars
// would re-create the script per page; this keeps a single bundled script.
const clientI18n = {
  fieldLabels: t.form.fields,
  pageLabel: t.formJs.pageLabel,
  sentLabel: t.formJs.sentLabel,
  subject: t.formJs.subject,
  oneClick: t.formJs.oneClick,
  sending: t.formJs.sending,
  sendingShort: t.formJs.sendingShort,
  submit: t.formJs.submit,
  received: t.formJs.received,
  couldNotSend: t.formJs.couldNotSend,
  couldNotSendShort: t.formJs.couldNotSendShort,
  useOneClick: t.formJs.useOneClick,
};
---
<section class="form-shell" id="enquiry-form">
  <h2>{t.form.title}</h2>
  <p style="margin:0;color:var(--ink-soft);font-size:14px">{t.form.intro}</p>
  <form id="b2b-enquiry" data-endpoint={endpoint} data-fallback={fallbackEmail} data-i18n={JSON.stringify(clientI18n)}>
    <div class="form-grid">
      <div class="field">
        <label for="full_name">{t.form.fields.full_name} <span class="req">*</span></label>
        <input id="full_name" name="full_name" type="text" required maxlength="500" placeholder={t.form.placeholders.full_name} />
      </div>
      <div class="field">
        <label for="company">{t.form.fields.company} <span class="req">*</span></label>
        <input id="company" name="company" type="text" required maxlength="500" placeholder={t.form.placeholders.company} />
      </div>
      <div class="field">
        <label for="email">{t.form.fields.email} <span class="req">*</span></label>
        <input id="email" name="email" type="email" required maxlength="200" placeholder={t.form.placeholders.email} />
      </div>
      <div class="field">
        <label for="country">{t.form.fields.country} <span class="req">*</span></label>
        <input id="country" name="country" type="text" required maxlength="500" placeholder={t.form.placeholders.country} />
      </div>
      <div class="field">
        <label for="product_interest">{t.form.fields.product_interest} <span class="req">*</span></label>
        <select id="product_interest" name="product_interest" required>
          <option value="">{t.form.selectPlaceholder}</option>
          {englishOptions.map((value, i) => <option value={value}>{labels[i] || value}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="estimated_quantity">{t.form.fields.estimated_quantity} <span class="req">*</span></label>
        <input id="estimated_quantity" name="estimated_quantity" type="text" required maxlength="500" placeholder={t.form.placeholders.estimated_quantity} />
        <span class="hint">{t.form.hints.quantity}</span>
      </div>
      <div class="field">
        <label for="target_market">{t.form.fields.target_market}</label>
        <input id="target_market" name="target_market" type="text" maxlength="500" placeholder={t.form.placeholders.target_market} />
      </div>
      <div class="field">
        <label for="annual_volume">{t.form.fields.annual_volume}</label>
        <input id="annual_volume" name="annual_volume" type="text" maxlength="500" placeholder={t.form.placeholders.annual_volume} />
      </div>
      <div class="field">
        <label for="preferred_incoterm">{t.form.fields.preferred_incoterm}</label>
        <select id="preferred_incoterm" name="preferred_incoterm">
          <option value="">{t.form.notSure}</option>
          <option>EXW</option><option>FOB</option><option>CIF</option><option>DDP</option>
        </select>
      </div>
      <div class="field field-full">
        <label for="message">{t.form.fields.message} <span class="req">*</span></label>
        <textarea id="message" name="message" required maxlength="5000" placeholder={t.form.placeholders.message}></textarea>
        <span class="hint">{t.form.hints.message}</span>
      </div>
    </div>

    <input type="hidden" name="_page" id="_page" value="" />
    <input type="hidden" name="_form_time" id="_form_time" value="" />
    <input type="hidden" name="_locale" value={locale} />
    <div class="hp" aria-hidden="true">
      <label for="_gotcha">{t.form.honeypot}</label>
      <input id="_gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p style="margin-top:20px">
      <button class="btn" type="submit">{t.form.submit}</button>
    </p>
    <div id="form-status" class="form-status" hidden role="status" aria-live="polite"></div>
    <p class="form-note">
      {t.form.noteBefore} <a href={`mailto:${fallbackEmail}`}>{fallbackEmail}</a> {t.form.noteAfter}
    </p>
  </form>
</section>

<script>
  const form = document.getElementById('b2b-enquiry');
  const status = document.getElementById('form-status');
  const pageInput = document.getElementById('_page');
  const timeInput = document.getElementById('_form_time');
  const i18n = JSON.parse(form?.dataset.i18n || '{}');
  const tmpl = (s, vars) => String(s || '').replace(/\{(\w+)\}/g, (m, k) =>
    Object.prototype.hasOwnProperty.call(vars, k) ? String(vars[k]) : m);

  if (pageInput) pageInput.value = window.location.href;
  const markOpened = () => { if (timeInput) timeInput.value = String(Date.now()); };
  markOpened();

  // Never lose a lead: pre-fill everything the visitor already typed into a
  // ready-to-send email. mailto bodies are capped by mail clients, so truncate.
  const fallbackMailto = (fallback, payload) => {
    const rows = Object.entries(i18n.fieldLabels || {})
      .map(([key, label]) => `${label}: ${(payload && payload[key]) || '-'}`);
    rows.push('', `${i18n.pageLabel || 'Page:'} ${window.location.href}`, `${i18n.sentLabel || 'Sent:'} ${new Date().toISOString()}`);
    const subject = tmpl(i18n.subject || 'B2B umbrella enquiry - {name} ({company})', {
      name: (payload && payload.full_name) || '',
      company: (payload && payload.company) || '',
    });
    const body = rows.join('\n').slice(0, 1800);
    return `mailto:${fallback}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };

  const show = (kind, message, fallback, payload) => {
    if (!status) return;
    status.hidden = false;
    status.className = `form-status ${kind}`;
    status.textContent = message;
    if (fallback) {
      status.append(' ');
      const link = document.createElement('a');
      link.className = 'form-fallback-link';
      link.href = fallbackMailto(fallback, payload);
      link.textContent = tmpl(i18n.oneClick || 'One-click: email your typed details to {email}', { email: fallback });
      status.append(link);
    }
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    const endpoint = form.dataset.endpoint || '/api/enquiry';
    const fallback = form.dataset.fallback || 'sales@fantasticumbrella.com';

    const payload = Object.fromEntries(new FormData(form).entries());
    payload._page = window.location.href;

    show('pending', i18n.sending || 'Sending your enquiry...');
    if (button) { button.disabled = true; button.textContent = i18n.sendingShort || 'Sending...'; }

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.ok) {
        throw new Error(result.message || i18n.couldNotSend || 'We could not send your enquiry. Please try again.');
      }
      show('ok', result.message || i18n.received || 'Thank you. Your enquiry has been received.');
      form.reset();
      if (pageInput) pageInput.value = window.location.href;
      markOpened();
    } catch (error) {
      const message = error instanceof Error ? error.message : (i18n.couldNotSendShort || 'We could not send your enquiry.');
      show('err', `${message} ${i18n.useOneClick || 'Use the one-click link below - your typed details are already filled in:'}`, fallback, payload);
    } finally {
      if (button) { button.disabled = false; button.textContent = i18n.submit || 'Request a Quote'; }
    }
  });
</script>
