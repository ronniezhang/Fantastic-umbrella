---
import { DEFAULT_LOCALE, localePath } from '../i18n/config.mjs';
import { ui } from '../i18n/dict.mjs';
import social from '../data/social.json';

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = ui(locale);
const L = (p) => localePath(locale, p);
const year = new Date().getFullYear();
// Only configured profiles are rendered. Empty hrefs in social.json stay hidden.
const profiles = social.profiles.filter((p) => p.href);
const whatsappHref = profiles.find((p) => p.id === 'whatsapp')?.href || '';
const ariaFor = (name) => t.footer.followOn.replace('{name}', name);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h3>Fantastic Umbrella</h3>
        <p style="font-size:14px;margin:0;line-height:1.7">{t.footer.brandDesc}</p>
      </div>
      <div>
        <h3>{t.footer.capabilities}</h3>
        <ul>
          <li><a href={L('/services/')}>{t.nav.services}</a></li>
          <li><a href={L('/products/')}>{t.footer.productRange}</a></li>
          <li><a href={L('/shipping-delivery/')}>{t.nav.shipping}</a></li>
          <li><a href={L('/quality-claims/')}>{t.nav.quality}</a></li>
        </ul>
      </div>
      <div>
        <h3>{t.footer.support}</h3>
        <ul>
          <li><a href={L('/faqs/')}>{t.nav.faq}</a></li>
          <li><a href={L('/contact/')}>{t.footer.contactUs}</a></li>
          <li><a href={L('/contact/#enquiry-form')}>{t.nav.quote}</a></li>
        </ul>
      </div>
      <div>
        <h3>{t.footer.getInTouch}</h3>
        <ul>
          <li><a href="mailto:sales@fantasticumbrella.com">sales@fantasticumbrella.com</a></li>
          <li>{t.footer.whatsapp}: <a href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label={ariaFor('WhatsApp')}>+86 137 2520 9358</a></li>
        </ul>
      </div>
    </div>
    {profiles.length > 0 && (
      <div class="footer-social">
        <h3>{t.footer.followUs}</h3>
        <ul class="social-list">
          {profiles.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener noreferrer" aria-label={ariaFor(p.label)} title={p.label}>
                <span class="social-badge" aria-hidden="true">{p.badge}</span>
                <span>{p.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    <div class="footer-bottom">
      <span>&copy; {year} Fantastic Umbrella. {t.footer.copyright}</span>
      <span>{t.footer.platformNote}</span>
    </div>
  </div>
</footer>
