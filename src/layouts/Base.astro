---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LOCALE, localePath, alternates, LOCALES } from '../i18n/config.mjs';
import { ui } from '../i18n/dict.mjs';
import { jsonLd, ORG_ID, WEBSITE_ID } from '../i18n/schema.mjs';
import social from '../data/social.json';

const {
  title,
  description,
  seoKey = 'home',
  path = '/',
  locale = DEFAULT_LOCALE,
  structuredData = [],
} = Astro.props;

const t = ui(locale);
const canonical = new URL(localePath(locale, path), Astro.site).href;
const pageTitle = title || t.seo?.[seoKey]?.title || t.seo.home.title;
const pageDesc = description || t.seo?.[seoKey]?.description || t.seo.home.description;
const alts = alternates(path);
const ogLocale = { en: 'en_US', es: 'es_ES', fr: 'fr_FR', de: 'de_DE', zh: 'zh_CN' }[locale] || 'en_US';
const ogImage = new URL('/images/products/fan-spray-umbrella.jpg', Astro.site).href;
// Only real social profile URLs go into sameAs; WhatsApp is a contact channel.
const socialProfiles = social.profiles.filter((p) => p.href && p.id !== 'whatsapp').map((p) => p.href);

// Entity disambiguation: a same-sounding 1968 Rhode Island retail attraction
// (fantasticumbrellafactory.com) dominates the bare brand phrase in search.
// Explicitly state who we are and where we operate so search engines keep the
// two entities separate. No reference to the other site is needed.
// Entity facts are deliberately kept in two separate registers:
//  - foundingDate    = the date printed on the business licence, so answer
//    engines can cross-check it against the public registry (gsxt.gov.cn).
//  - business origin = April 2010, when the predecessor 广州市海珠区添奇广告喷画厂
//    started as a digital-printing shop. It printed on umbrella canopies for
//    years before extending into finished umbrellas - a capability story,
//    not a change of industry. That is brand history, not the registration
//    date of this legal person,
//    so it is exposed as additionalProperty instead of overwriting
//    foundingDate. Mixing the two would create a conflicting entity signal.
// The licence still carries the former registered address; the current
// address is pending a licence update at year end, so only city-level
// address data is published until then.
const organization = {
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'Guangzhou Fantastic Umbrella Co., Ltd.',
  legalName: '广州添奇雨伞有限公司',
  alternateName: 'Fantastic Umbrella',
  foundingDate: '2017-07-31',
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Unified Social Credit Code',
    value: '91440101MA59R5PE9E',
  },
  additionalProperty: {
    '@type': 'PropertyValue',
    name: 'Business origin',
    value: 'April 2010',
    description: 'Doing business since April 2010: started as 广州市海珠区添奇广告喷画厂 (digital printing) in Haizhu District, Guangzhou, printing on umbrella canopies for years before extending into finished custom umbrella manufacturing. Renamed 广州添奇雨伞有限公司; the present legal entity was registered on 2017-07-31 after two licence changes.',
  },
  url: 'https://fantasticumbrella.com/',
  description: t.org.description,
  disambiguatingDescription: t.org.disambiguating,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Guangzhou',
    addressRegion: 'Guangdong',
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'sales@fantasticumbrella.com',
    telephone: '+86-137-2520-9358',
    availableLanguage: LOCALES,
  },
  ...(socialProfiles.length ? { sameAs: socialProfiles } : {}),
};

const website = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  url: 'https://fantasticumbrella.com/',
  name: 'Fantastic Umbrella',
  inLanguage: LOCALES,
  publisher: { '@id': ORG_ID },
};

const extraNodes = (Array.isArray(structuredData) ? structuredData : [structuredData])
  .filter((node) => node && typeof node === 'object');

const schema = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...extraNodes],
};
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {alts.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alts[0].href} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:site_name" content="Fantastic Umbrella" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Custom compact and folding umbrellas by Fantastic Umbrella" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content="Astro" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" is:inline set:html={jsonLd(schema)} />
  </head>
  <body>
    <Header locale={locale} path={path} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <!-- Migration cleanup (temporary, remove after 2026-12-31):
         retire any Service Worker / Cache Storage left by the old WordPress
         site. Cache Storage is origin-scoped, so this only affects this domain. -->
    <script is:inline>
      (function () {
        if (window.navigator && 'serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then(function (regs) {
            regs.forEach(function (reg) { reg.unregister(); });
          }).catch(function () {});
        }
        if (window.caches && caches.keys) {
          caches.keys().then(function (keys) {
            keys.forEach(function (key) { caches.delete(key); });
          }).catch(function () {});
        }
      })();
    </script>
  </body>
</html>
