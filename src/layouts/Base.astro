---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LOCALE, localePath, alternates } from '../i18n/config.mjs';
import { ui } from '../i18n/dict.mjs';
import social from '../data/social.json';

const {
  title,
  description,
  seoKey = 'home',
  path = '/',
  locale = DEFAULT_LOCALE,
} = Astro.props;

const t = ui(locale);
const canonical = new URL(localePath(locale, path), Astro.site).href;
const pageTitle = title || t.seo?.[seoKey]?.title || t.seo.home.title;
const pageDesc = description || t.seo?.[seoKey]?.description || t.seo.home.description;
const alts = alternates(path);
const ogLocale = { en: 'en_US', es: 'es_ES', fr: 'fr_FR', de: 'de_DE' }[locale] || 'en_US';
const ogImage = new URL('/images/products/fan-spray-umbrella.jpg', Astro.site).href;
// Only real social profile URLs go into sameAs; WhatsApp is a contact channel.
const socialProfiles = social.profiles.filter((p) => p.href && p.id !== 'whatsapp').map((p) => p.href);

// Entity disambiguation: a same-sounding 1968 Rhode Island retail attraction
// (fantasticumbrellafactory.com) dominates the bare brand phrase in search.
// Explicitly state who we are and where we operate so search engines keep the
// two entities separate. No reference to the other site is needed.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Guangzhou Fantastic Umbrella Co., Ltd.',
  alternateName: 'Fantastic Umbrella',
  url: 'https://fantasticumbrella.com/',
  description: t.org.description,
  disambiguatingDescription: t.org.disambiguating,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Guangzhou',
    addressRegion: 'Guangdong',
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'sales@fantasticumbrella.com',
    telephone: '+86-137-2520-9358',
    availableLanguage: ['en', 'es', 'fr', 'de'],
  },
  ...(socialProfiles.length ? { sameAs: socialProfiles } : {}),
};
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {alts.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alts[0].href} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:site_name" content="Fantastic Umbrella" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Custom compact and folding umbrellas by Fantastic Umbrella" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content="Astro" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header locale={locale} path={path} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <!-- Migration cleanup (temporary, remove after 2026-12-31):
         retire any Service Worker / Cache Storage left by the old WordPress
         site. Cache Storage is origin-scoped, so this only affects this domain. -->
    <script is:inline>
      (function () {
        if (window.navigator && 'serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then(function (regs) {
            regs.forEach(function (reg) { reg.unregister(); });
          }).catch(function () {});
        }
        if (window.caches && caches.keys) {
          caches.keys().then(function (keys) {
            keys.forEach(function (key) { caches.delete(key); });
          }).catch(function () {});
        }
      })();
    </script>
  </body>
</html>
