---
import Base from '../../layouts/Base.astro';
import products from '../../data/products.json';

const primary = products.filter((p) => p.scope === 'primary');
const secondary = products.filter((p) => p.scope === 'secondary');
---
<Base
  path="/products/"
  title="Compact & Folding Umbrellas | Custom Umbrella OEM Supplier"
  description="Custom compact, folding, straight, golf and kids rain umbrellas for B2B programmes, plus a small beach umbrella range. Custom frames, fabric and printing on request."
>
  <section class="hero" style="padding:48px 0">
    <div class="wrap">
      <p class="eyebrow">Product range</p>
      <h1>Compact &amp; folding umbrellas</h1>
      <p>
        {primary.length} core handheld umbrella styles, plus {secondary.length} beach umbrellas.
        Each can be adapted in size, frame, fabric and print. Every product on this
        site is an enquiry item — there is no retail checkout.
      </p>
      <a class="btn" href="/contact/#enquiry-form">Request a Quote</a>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2>Core range &middot; handheld rain umbrellas</h2>
      <div class="product-grid">
        {primary.map((p) => (
          <a class="product-card" href={`/product/${p.slug}/`}>
            <div class="thumb">
              {p.image
                ? <img src={p.image} alt={p.name} loading="lazy" />
                : <span style="color:#8b9aa8;font-size:13px">Image pending</span>}
            </div>
            <div class="body">
              <h3>{p.name}</h3>
              <span class="link">View &amp; enquire &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <h2 style="margin-top:52px">Beach umbrellas &amp; parasols</h2>
      <p>A small supporting range for resort and promotional programmes.</p>
      <div class="product-grid">
        {secondary.map((p) => (
          <a class="product-card" href={`/product/${p.slug}/`}>
            <div class="thumb">
              {p.image
                ? <img src={p.image} alt={p.name} loading="lazy" />
                : <span style="color:#8b9aa8;font-size:13px">Image pending</span>}
            </div>
            <div class="body">
              <h3>{p.name}</h3>
              <span class="link">View &amp; enquire &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <p style="margin-top:36px;font-size:14px;color:var(--ink-soft)">
        Beach chairs, cabanas, sun shelters, gazebos and patio shade structures are
        not part of this site's range — they are handled by our GreenMark sister site.
      </p>
    </div>
  </section>
</Base>
