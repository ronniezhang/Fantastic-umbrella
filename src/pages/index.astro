---
import Base from '../layouts/Base.astro';
import products from '../data/products.json';

const primary = products.filter((p) => p.scope === 'primary');
const featured = (primary.length ? primary : products).slice(0, 6);
const capabilities = [
  {
    num: '01',
    title: 'Digital printing',
    text: 'All-over custom print, Pantone matching and a digital layout for approval before any strike-off is produced.',
  },
  {
    num: '02',
    title: 'Sampling & tooling',
    text: 'Printed strike-off or full prototype, with changes confirmed in writing before bulk production starts.',
  },
  {
    num: '03',
    title: 'Quality control',
    text: 'In-line checks and pre-shipment inspection against an agreed specification sheet, with third-party audits on request.',
  },
];
---
<Base seoKey="home" path="/">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">B2B manufacturing &middot; Guangzhou, China</p>
      <h1>Custom compact and folding umbrellas, built to your specification.</h1>
      <p>
        OEM and ODM supply of handheld rain umbrellas for distributors, retail brands
        and promotional programmes. A small selection of beach umbrellas is available
        alongside the core range. We handle artwork, sampling, production, inspection
        and export documentation in one supply chain — starting with a written
        quotation, not a checkout.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/contact/#enquiry-form">Request a Quote</a>
        <a class="btn btn-ghost" href="/services/">Explore our capabilities</a>
      </div>
      <p class="hero-note">
        MOQ, lead times and inspection standards are indicative and are confirmed in
        writing with your quotation and specification sheet.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>One supply chain, from artwork to shipment</h2>
      <p>
        We started in digital printing and grew into full custom manufacturing.
        That means print, construction and finishing are managed together rather
        than handed between suppliers.
      </p>
      <div class="grid-3">
        {capabilities.map((c) => (
          <div class="card">
            <span class="num">{c.num}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--wash);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="wrap">
      <h2>Built for programmes, not one-off orders</h2>
      <p>Everything below is agreed in writing before production, so repeat orders stay consistent.</p>
      <div class="grid-3">
        <div class="card"><h3>OEM &amp; ODM</h3><p>Your design and specification, or ours adapted to your market.</p></div>
        <div class="card"><h3>Private label</h3><p>Custom labels, packaging and retail-ready presentation.</p></div>
        <div class="card"><h3>Export-ready</h3><p>EXW, FOB and CIF terms, packing data and shipment documents.</p></div>
      </div>
      <p style="margin-top:26px"><a class="btn btn-ghost" href="/faqs/">Read the B2B FAQ</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Compact and folding umbrellas</h2>
      <p>
        Our core range is handheld rain umbrellas — three-fold, five-fold, straight,
        golf and kids styles. A few beach umbrellas are available for resort and
        promotional programmes. Every item can be adapted in size, frame, fabric and print.
      </p>
      <div class="product-grid">
        {featured.map((p) => (
          <a class="product-card" href={`/product/${p.slug}/`}>
            <div class="thumb">
              {p.image
                ? <img src={p.image} alt={p.name} loading="lazy" />
                : <span style="color:#8b9aa8;font-size:13px">Image pending</span>}
            </div>
            <div class="body">
              <h3>{p.name}</h3>
              <p>Custom printing and specification on request.</p>
              <span class="link">View &amp; enquire &rarr;</span>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top:26px"><a class="btn btn-ghost" href="/products/">See all {products.length} products</a></p>
      <p style="margin-top:18px;font-size:14px;color:var(--ink-soft)">
        Looking for beach chairs, cabanas, sun shelters or patio shade structures?
        Those product lines are handled by our GreenMark sister site.
      </p>
    </div>
  </section>

  <section class="section" style="background:var(--navy);color:#fff">
    <div class="wrap">
      <h2 style="color:#fff">Tell us what you need</h2>
      <p style="color:#c8d7e4">Share a design, a quantity and your market — we reply with a written quotation and the next steps.</p>
      <a class="btn" href="/contact/#enquiry-form">Request a Quote</a>
    </div>
  </section>
</Base>
